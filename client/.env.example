# ==========================================
# MamunStore Frontend Environment Configuration
# ==========================================

# 1. Local Development (Default):
# In local Vite development (import.meta.env.DEV), axiosInstance defaults to http://localhost:5000/api.
# You can override it here if your backend is running on a different port:
VITE_API_URL=http://localhost:5000/api

# 2. Production Deployment with Vercel Same-Domain /api Proxy (Recommended):
# When using Vercel rewrites (verifying HTTP-only cookies on the same domain):
# VITE_API_URL=/api

# 3. Production Deployment with Direct Backend URL:
# If communicating directly with a standalone backend service:
# VITE_API_URL=https://your-backend-service.onrender.com/api

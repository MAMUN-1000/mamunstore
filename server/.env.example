# ==========================================
# MamunStore Backend Environment Configuration
# ==========================================

# Port (Cloud providers like Render/Railway automatically assign PORT)
PORT=5000

# Environment mode ('development', 'test', or 'production')
NODE_ENV=development

# Allowed Frontend Origin for CORS (e.g. https://mamunstore.vercel.app or http://localhost:5173)
# Note: Trailing slashes are automatically sanitized by the server.
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL Database URL (Must include ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Strong secret key for signing JSON Web Tokens (JWT)
# IMPORTANT: In production, the server will refuse to start if this is unset or left as the default placeholder.
JWT_SECRET="generate-a-strong-random-secret-key-for-production-min-32-chars"

# ==========================================
# bKash Sandbox / Production Configuration
# ==========================================
# Base URL:
# - Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# - Production: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME="your-bkash-username"
BKASH_PASSWORD="your-bkash-password"
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_SECRET="your-bkash-app-secret"

# Callback URL registered with bKash (must reach your backend /api/bkash/callback endpoint)
# - Local dev: http://localhost:5000/api/bkash/callback
# - Production: https://your-backend.onrender.com/api/bkash/callback
BKASH_CALLBACK_URL="http://localhost:5000/api/bkash/callback"
